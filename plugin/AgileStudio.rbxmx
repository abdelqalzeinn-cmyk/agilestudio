-- ============================================================ Streaming Typewriter Effect
function typewriterText(label, fullText, speed)
	speed = speed or 20
	local current = ""
	label.Text = ""
	local i = 1
	task.spawn(function()
		while i <= #fullText do
			local chunk = fullText:sub(i, math.min(i + 3, #fullText))
			current = current .. chunk
			label.Text = current
			i = i + #chunk
			task.wait(speed / 1000)
		end
	end)
	return function() -- stop function
		i = #fullText + 1
	end
end

